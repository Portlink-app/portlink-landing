{
  "name": "portlink-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-ds-version.mjs && node scripts/lint-dashes.mjs && node scripts/check-clip-modes.mjs --if-available && npm run check:leaderboard",
    "check:clips": "node scripts/check-clip-modes.mjs",
    "verify": "npm run lint:dashes && npm run lint:dashes-selftest && npm run check:clips && npm run check:leaderboard && npm run lint",
    "lint:dashes": "node scripts/lint-dashes.mjs",
    "lint:dashes-selftest": "node scripts/lint-dashes.selftest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ds:check": "node scripts/check-ds-version.mjs --strict",
    "check:leaderboard": "tsx scripts/check-leaderboard-privacy.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@netlify/blobs": "^11.0.3",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.19",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
